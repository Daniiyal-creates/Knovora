# ----- Supabase -----
# Public (safe to expose to the browser). New-style publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only (NEVER expose to the browser / widget). New-style secret key.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ----- Gemini -----
# Server-only
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# Protects the background ingestion endpoint (/api/ingest). Set to a random string.
INGEST_SECRET=change-me

# ----- App -----
# Public base URL of the deployment (used for embed snippet + hosted chat links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
